{
  "name": "videorealtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"tsx watch server/index.ts\" \"vite --config client/vite.config.ts\"",
    "build": "vite build --config client/vite.config.ts",
    "start": "npm run build && tsx server/index.ts",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p client/tsconfig.json",
    "release": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "localtunnel": "^2.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "archiver": "^7.0.1",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
